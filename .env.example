# =========================================================================
# CANDIDATE.ph — Environment Variables
# =========================================================================

# -------------------------------------------------------------------------
# 1. Supabase PostgreSQL Configuration
# -------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# -------------------------------------------------------------------------
# 2. PayMongo Payment Gateway Configuration
# -------------------------------------------------------------------------
# Found in PayMongo Dashboard -> Developers -> API Keys
# Public key for frontend checkout widgets (GCash, Maya, Cards)
VITE_PAYMONGO_PUBLIC_KEY=pk_test_your_paymongo_public_key

# Secret key for serverless webhooks and payment intent verification (NEVER expose to client)
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key
PAYMONGO_WEBHOOK_SECRET=whsec_your_paymongo_webhook_secret
